# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notes

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object storage (S3-compatible) ───────────────────────────
# No object store ships with the local stack any more (the MinIO
# container was removed). Leave these empty to run without audio at
# rest, or point them at a real S3-compatible endpoint + bucket keys.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Keycloak ─────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=notes
KEYCLOAK_CLIENT_ID=backend-api
KEYCLOAK_CLIENT_SECRET=dev-secret-change-in-prod

# ── OpenTelemetry ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=template-service

# ── Dev flags ────────────────────────────────────────────────
# WARNING: disables auth enforcement in dev only — never set in staging/prod
AUTH_BYPASS_DEV=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Google Calendar (note-service, 0019) ─────────────────────
# Optional. Without a client id the "Connect Google Calendar" button is
# hidden, but users can still add a calendar by its private iCal address
# ("Add calendar link", 0020) — that path needs no configuration.
# Leave the client id empty and the "Coming up" list hides its connect
# button. Create an OAuth 2.0 client (Web application) in Google Cloud
# Console and register the redirect URI below on it, exactly.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8006/v1/calendar/google/callback

# Host interface the client-facing services (auth :8000, ASR :8001, notes
# :8006) are published on. Default 127.0.0.1 = this machine only. Set
# 0.0.0.0 so the iOS app on a phone (or any device on your Wi‑Fi) can
# reach the dev stack at http://<your Mac's LAN address>:8000 etc.
# Then `docker compose up -d auth-service asr-service note-service`.
PUBLISH_HOST=127.0.0.1

# ── Model backends (libs/models, config/models.yaml — DEP-S0) ─────────
# ENV selects the registry environment: dev | test | staging | prod.
# In dev, chat/ASR route to this Mac (`make dev-model` starts the servers);
# the HF_* variables are only required when ENV=staging|prod.
ENV=dev
# Ollama / LM Studio / MLX-serve on this Mac, as seen FROM Docker:
DEV_MAC_MODEL_URL=http://host.docker.internal:11434/v1
DEV_MAC_CHAT_MODEL=notes-chat
# whisper.cpp server (OpenAI path). Use :8090 if something else owns :8080.
DEV_MAC_ASR_URL=http://host.docker.internal:8080
# Which backend asr-worker uses: inproc_cpu_asr (default, baked faster-whisper)
# or dev_mac_asr (whisper.cpp on this Mac, needs `make dev-model`).
ASR_BACKEND=inproc_cpu_asr
# Hugging Face Inference Endpoints, EU (staging/beta) — DEP-S1 provisions these.
HF_CHAT_ENDPOINT_URL=
HF_ASR_ENDPOINT_URL=
HF_TOKEN=
# HF org/user that owns the endpoints (scripts/models/hf_endpoints.py)
HF_NAMESPACE=
HF_CHAT_MODEL_PIN=
HF_ASR_MODEL_PIN=

# ── Self-serve signup (BE-0) ──────────────────────────────────────────────
# OFF by default. Signup creates Keycloak users and sends mail to addresses
# nobody has verified, so a deployment opts in rather than discovering it is
# open because a router happened to be mounted. Needs a mail relay
# (MDX_EMAIL_PROVIDER=smtp + the MDX_AUTH_SMTP_* values below) and Redis:
# the per-IP and per-email caps fail CLOSED, and a limiter that is absent
# rather than merely unavailable would fail open by omission.
#
# Mounted in MDX_IDP_MODE=keycloak and dual. In native, Keycloak no longer
# holds credentials and /auth/email/* is the way in.
MDX_SIGNUP_ENABLED=false
AUTH_SIGNUP_TTL_SECONDS=600
AUTH_SIGNUP_MAX_ATTEMPTS=5
AUTH_SIGNUP_RESEND_SECONDS=60
# Mirror of the realm password policy, so the API refuses what Keycloak
# would refuse — with a field-level reason instead of a realm error.
AUTH_SIGNUP_MIN_PASSWORD_LENGTH=12
AUTH_SIGNUP_IP_LIMIT=5
AUTH_SIGNUP_IP_WINDOW_SECONDS=3600
AUTH_SIGNUP_EMAIL_LIMIT=3
AUTH_SIGNUP_EMAIL_WINDOW_SECONDS=86400
AUTH_SIGNUP_VERIFY_EMAIL_LIMIT=10
AUTH_SIGNUP_VERIFY_EMAIL_WINDOW_SECONDS=3600
AUTH_SIGNUP_RESEND_EMAIL_LIMIT=3
AUTH_SIGNUP_RESEND_EMAIL_WINDOW_SECONDS=3600
# How long an unconfirmed account survives before
# `python -m auth_service.ops.cleanup_invited` removes it (Keycloak user,
# users row, membership and its empty workspace).
AUTH_SIGNUP_STALE_AFTER_DAYS=30

# ── Sharing a note by e-mail (note-service) ───────────────────────────────
# "Send" in the share sheet mails the note from the SERVER, as a branded
# HTML message — the clients no longer hand a `mailto:` URL to the desktop
# mail client. Unset, the dev stack points these at Mailpit
# (http://localhost:8025) and nothing reaches a real mailbox.
#
# MDX_EMAIL_PROVIDER is shared with auth-service: `mock` captures in memory
# and REFUSES to start in production/staging, `smtp` talks to the relay.
# MDX_NOTE_SMTP_PASSWORD on Google Workspace must be a 16-character App
# Password, not the account password (`535-5.7.8` is the symptom).
#
# These are SEPARATE from the MDX_AUTH_SMTP_* values above. Setting only
# the auth ones is the trap: sign-in codes reach real inboxes while every
# shared note goes to Mailpit, and the sharer is still told "Sent to ...".
# To deliver share mail for real, set all of these too — the same mailbox
# and App Password is fine. Gmail refuses a From: it did not authenticate
# as, so MDX_NOTE_EMAIL_FROM must equal MDX_NOTE_SMTP_USERNAME.
MDX_NOTE_SMTP_HOST=mailpit
MDX_NOTE_SMTP_PORT=1025
MDX_NOTE_SMTP_USE_TLS=false
MDX_NOTE_SMTP_USERNAME=
MDX_NOTE_SMTP_PASSWORD=
MDX_NOTE_EMAIL_FROM=notes@notes-ai.local
MDX_NOTE_EMAIL_FROM_NAME=Notes AI
# Replies go to the colleague who pressed Send; this is only the fallback
# for a sharer with no address on file.
MDX_NOTE_EMAIL_REPLY_TO=notes@notes-ai.local
# The origin the mailed links point at — the one the SPA is actually served
# from, or every shared note lands on a 404. Shared with auth-service.
MDX_APP_BASE_URL=http://localhost:5173
# Per-sender hourly cap, counted in RECIPIENTS so batching is not a way
# around it. A share endpoint that mails anywhere is a spam relay wearing
# our From address.
MDX_SHARE_EMAILS_PER_USER_PER_HOUR=60
MDX_SHARE_EMAIL_MAX_RECIPIENTS=10

# ── Trusted issuers (FND-1, ADR-0047) ─────────────────────────────────────
# Every service verifies a bearer token against the entry in this list whose
# `issuer` matches the token's own `iss`, and against that entry only. Leave
# it unset and the AUTH_ISSUER / AUTH_JWKS_URL / AUTH_AUDIENCE trio below
# builds a one-element list — exactly the pre-FND-1 behaviour.
#
# Deploy this to the whole fleet BEFORE auth-service starts minting. The
# second issuer's JWKS is empty-but-valid until MDX_IDP_MODE=dual, which is
# harmless: an issuer with no keys rejects tokens, it does not disturb the
# issuer beside it.
#
# `issuer` and `jwks_url` are two different addresses for the same service
# and must be written as such. `issuer` is the browser-facing origin,
# because that is what the token's `iss` carries. `jwks_url` is fetched by
# each consumer from INSIDE the network, where `localhost:8000` is the
# consuming container itself — note-service fetching its own 404 page
# instead of a key set, and rejecting every native token with
# `kid_not_found`. Name auth-service by its in-cluster address.
# AUTH_ISSUERS_JSON=[{"issuer":"http://keycloak:8080/realms/notes","jwks_url":"http://keycloak:8080/realms/notes/protocol/openid-connect/certs","audience":"mdx-api"},{"issuer":"http://localhost:8000","jwks_url":"http://auth-service:8000/.well-known/jwks.json","audience":"mdx-api"}]

# ── Native issuer (IDX-A2; `dual` from FND-0 / ADR-0047) ──────────────────
# keycloak (default) keeps today's Keycloak-backed login/refresh/logout.
#   It does NOT mount `/auth/email/*`, so sign-in by emailed code is not
#   merely unconfigured there, it 404s — which is what the web sign-in page
#   reports as "Sign-in by email code is not enabled here. Use a password
#   instead." Anything that offers the code path needs `dual` or `native`.
# dual: auth-service mints for email-code logins while Keycloak keeps
#   minting for password logins. Both issuers live; needs AUTH_ISSUERS_JSON
#   deployed fleet-wide first, and AUTH_SIGNING_KEYS_JSON here. Bounded to
#   <= 8 weeks (ADR-0047). Rollback is MDX_IDP_MODE=keycloak, which leaves
#   identities created during the period unable to sign in until it is
#   restored.
# native: auth-service signs RS256 tokens and serves /.well-known/jwks.json;
#   Keycloak is out of the token path entirely.
MDX_IDP_MODE=keycloak
# `iss` of native tokens; every service's AUTH_ISSUER must equal it at cut-over,
# with AUTH_JWKS_URL=${AUTH_ISSUER_URL}/.well-known/jwks.json.
AUTH_ISSUER_URL=http://localhost:8000
AUTH_ACCESS_TTL_SECONDS=900
# How long a refresh token stays usable (30 days). The window slides forward
# on every rotation, so this is an IDLE timeout.
AUTH_REFRESH_TTL_SECONDS=2592000
# The ceiling the sliding window never passes, measured from when the session
# started (90 days). A session that can renew itself forever is one nobody
# ever revokes.
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=7776000
# How long the refresh token retired by a rotation still works (IDX-M1).
# Inside the window a re-presented token is a dropped response and is
# answered with a fresh token; outside it, it is a replay — the session is
# revoked and the identity's access tokens are denylisted.
AUTH_REFRESH_GRACE_SECONDS=30
# The tenant audit events with no customer are written to (a code requested
# for an address nobody has registered). Seeded by migration 0024.
AUTH_PLATFORM_TENANT_ID=00000000-0000-0000-0000-0000000000f1
# How long a proof of identity counts as "recent" for the endpoints that can
# take an account away from its owner: disable MFA, change email, delete the
# account, end every other session (IDX-A5).
AUTH_REAUTH_WINDOW_SECONDS=300
# JSON list of {kid, private_pem, not_after} — generate with
# `python scripts/ops/gen-signing-key.py --list`. Secret store only; never here.
# AUTH_SIGNING_KEYS_JSON=
# Dev only: the compose stack mounts infra/dev/auth-signing-dev.json instead.
# AUTH_SIGNING_KEYS_FILE=/etc/mdx/auth-signing.json

# ── Email one-time codes (IDX-A3) ──────────────────────────────────────────
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60
# Abuse caps (fixed windows). start_* fail closed when Redis is down.
AUTH_OTP_START_EMAIL_LIMIT=5
AUTH_OTP_START_EMAIL_WINDOW_SECONDS=900
AUTH_OTP_START_IP_LIMIT=20
AUTH_OTP_START_IP_WINDOW_SECONDS=3600
AUTH_OTP_VERIFY_IP_LIMIT=60
AUTH_OTP_VERIFY_IP_WINDOW_SECONDS=900
# The code mail is sent inline, not through the outbox worker — a ten-minute
# code the user waits in a queue for is a code that arrives too late.
AUTH_EMAIL_SEND_TIMEOUT_SECONDS=5
# Lockout after repeated failures: 10 → 15 min, doubling, capped at 1 h.
AUTH_LOCKOUT_THRESHOLD=10
AUTH_LOCKOUT_BASE_SECONDS=900
AUTH_LOCKOUT_MAX_SECONDS=3600
# Comma-separated CIDRs whose X-Forwarded-For is believed (empty: TCP peer is the client).
TRUSTED_PROXY_CIDRS=
