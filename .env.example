# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notes

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO (S3-compatible) ────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Keycloak ─────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=notes
KEYCLOAK_CLIENT_ID=backend-api
KEYCLOAK_CLIENT_SECRET=dev-secret-change-in-prod

# ── OpenTelemetry ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=template-service

# ── Dev flags ────────────────────────────────────────────────
# WARNING: disables auth enforcement in dev only — never set in staging/prod
AUTH_BYPASS_DEV=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Google Calendar (note-service, 0019) ─────────────────────
# Optional. Without a client id the "Connect Google Calendar" button is
# hidden, but users can still add a calendar by its private iCal address
# ("Add calendar link", 0020) — that path needs no configuration.
# Leave the client id empty and the "Coming up" list hides its connect
# button. Create an OAuth 2.0 client (Web application) in Google Cloud
# Console and register the redirect URI below on it, exactly.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8006/v1/calendar/google/callback

# Host interface the client-facing services (auth :8000, ASR :8001, notes
# :8006) are published on. Default 127.0.0.1 = this machine only. Set
# 0.0.0.0 so the iOS app on a phone (or any device on your Wi‑Fi) can
# reach the dev stack at http://<your Mac's LAN address>:8000 etc.
# Then `docker compose up -d auth-service asr-service note-service`.
PUBLISH_HOST=127.0.0.1
