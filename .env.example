# Copy to .env.local (gitignored) and fill in real values.

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notes

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object storage (S3-compatible) — unset = the stack's MinIO ───
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Keycloak ─────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=notes
KEYCLOAK_CLIENT_ID=backend-api
KEYCLOAK_CLIENT_SECRET=dev-secret-change-in-prod

# ── OpenTelemetry ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=template-service

# ── Dev flags (AUTH_BYPASS_DEV: never in staging/prod) ───────
AUTH_BYPASS_DEV=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── Google Calendar OAuth (optional; iCal links need none of it) ──
# Register the redirect URI below on the Google OAuth client, exactly.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8006/v1/calendar/google/callback

# Host interface for the client-facing services; 0.0.0.0 lets a phone on
# the LAN reach the dev stack.
PUBLISH_HOST=127.0.0.1

# ── Model backends (libs/models, config/models.yaml) ──────────────────
# ENV: dev | test | staging | prod. HF_* are required only for staging|prod.
ENV=dev
# Mistral EU key (dev: one per person). Empty = the local model writes.
MISTRAL_API_KEY=
# MISTRAL_API_URL=https://api.mistral.ai/v1
# Force the local model even with the key present (dev only):
# MDX_DEV_CHAT_BACKEND=dev_mac
# Ollama / LM Studio / MLX-serve on this Mac, as seen FROM Docker:
DEV_MAC_MODEL_URL=http://host.docker.internal:11434/v1
DEV_MAC_CHAT_MODEL=notes-chat
# whisper.cpp server; use :8090 if something else owns :8080.
DEV_MAC_ASR_URL=http://host.docker.internal:8080
# inproc_cpu_asr (baked faster-whisper) or dev_mac_asr (needs `make dev-model`).
ASR_BACKEND=inproc_cpu_asr
# Upload caps (clients read them from GET /asr/limits):
# MD_ASR_MAX_DURATION_SECONDS=7200
# MD_ASR_MAX_UPLOAD_MB=250
# Hugging Face Inference Endpoints, EU (staging/beta).
HF_CHAT_ENDPOINT_URL=
HF_ASR_ENDPOINT_URL=
HF_TOKEN=
# HF org/user that owns the endpoints (scripts/models/hf_endpoints.py)
HF_NAMESPACE=
HF_CHAT_MODEL_PIN=
HF_ASR_MODEL_PIN=
# Diarization endpoint (deploy/diar-server); used when MDX_DIAR_ENGINE=http.
HF_DIAR_ENDPOINT_URL=
HF_DIAR_MODEL_PIN=pyannote-community-1
# Bearer token diar-server requires (or MDX_DIAR_SERVER_ALLOW_ANONYMOUS=1 on a laptop).
MDX_DIAR_SERVER_TOKEN=

# ── Self-serve signup (keycloak/dual modes) ──────────────────────────────
# Off by default; needs a mail relay and Redis (the caps fail CLOSED).
MDX_SIGNUP_ENABLED=false
AUTH_SIGNUP_TTL_SECONDS=600
AUTH_SIGNUP_MAX_ATTEMPTS=5
AUTH_SIGNUP_RESEND_SECONDS=60
# Mirrors the realm password policy.
AUTH_SIGNUP_MIN_PASSWORD_LENGTH=12
AUTH_SIGNUP_IP_LIMIT=5
AUTH_SIGNUP_IP_WINDOW_SECONDS=3600
AUTH_SIGNUP_EMAIL_LIMIT=3
AUTH_SIGNUP_EMAIL_WINDOW_SECONDS=86400
AUTH_SIGNUP_VERIFY_EMAIL_LIMIT=10
AUTH_SIGNUP_VERIFY_EMAIL_WINDOW_SECONDS=3600
AUTH_SIGNUP_RESEND_EMAIL_LIMIT=3
AUTH_SIGNUP_RESEND_EMAIL_WINDOW_SECONDS=3600
# Unconfirmed accounts are removed after this by auth_service.ops.cleanup_invited.
AUTH_SIGNUP_STALE_AFTER_DAYS=30

# ── Share mail (note-service) — SEPARATE from MDX_AUTH_SMTP_* ─────────────
# Setting only the auth values sends every shared note to Mailpit while the
# API still says "Sent". Gmail needs an App Password (`535-5.7.8` otherwise)
# and MDX_NOTE_EMAIL_FROM must equal MDX_NOTE_SMTP_USERNAME.
MDX_NOTE_SMTP_HOST=mailpit
MDX_NOTE_SMTP_PORT=1025
MDX_NOTE_SMTP_USE_TLS=false
MDX_NOTE_SMTP_USERNAME=
MDX_NOTE_SMTP_PASSWORD=
MDX_NOTE_EMAIL_FROM=notes@notes-ai.local
MDX_NOTE_EMAIL_FROM_NAME=Notes AI
# Fallback Reply-To for a sharer with no address on file.
MDX_NOTE_EMAIL_REPLY_TO=notes@notes-ai.local
# Origin the SPA is served from, or mailed links 404. Shared with auth-service.
MDX_APP_BASE_URL=http://localhost:5173
# Per-sender hourly cap, counted in recipients.
MDX_SHARE_EMAILS_PER_USER_PER_HOUR=60
MDX_SHARE_EMAIL_MAX_RECIPIENTS=10

# ── Trusted issuers (ADR-0047) ────────────────────────────────────────────
# A token is verified only against the entry whose `issuer` matches its `iss`;
# unset = one-element list from AUTH_ISSUER / AUTH_JWKS_URL / AUTH_AUDIENCE.
# Deploy fleet-wide BEFORE auth-service mints. `issuer` is the browser-facing
# origin; `jwks_url` must be the in-cluster address (localhost = the consumer
# itself, which yields `kid_not_found`).
# AUTH_ISSUERS_JSON=[{"issuer":"http://keycloak:8080/realms/notes","jwks_url":"http://keycloak:8080/realms/notes/protocol/openid-connect/certs","audience":"mdx-api"},{"issuer":"http://localhost:8000","jwks_url":"http://auth-service:8000/.well-known/jwks.json","audience":"mdx-api"}]

# ── Native issuer (ADR-0047) ──────────────────────────────────────────────
# keycloak: Keycloak-backed login; /auth/email/* is not mounted (404).
# dual: auth-service mints for email-code logins, Keycloak for passwords;
#   needs AUTH_ISSUERS_JSON fleet-wide first and AUTH_SIGNING_KEYS_JSON here.
# native: auth-service signs RS256 and serves /.well-known/jwks.json.
MDX_IDP_MODE=keycloak
# `iss` of native tokens; at cut-over every service's AUTH_ISSUER must equal it.
AUTH_ISSUER_URL=http://localhost:8000
AUTH_ACCESS_TTL_SECONDS=900
# Idle timeout: slides forward on every rotation.
AUTH_REFRESH_TTL_SECONDS=2592000
# Ceiling the sliding window never passes.
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=7776000
# Inside the grace window a re-presented refresh token is a dropped response;
# outside it, a replay that revokes the session.
AUTH_REFRESH_GRACE_SECONDS=30
# Tenant for audit events with no customer (migration 0024).
AUTH_PLATFORM_TENANT_ID=00000000-0000-0000-0000-0000000000f1
# How long a proof of identity counts as recent for account-destructive endpoints.
AUTH_REAUTH_WINDOW_SECONDS=300
# JSON list of {kid, private_pem, not_after} (scripts/ops/gen-signing-key.py --list).
# Secret store only; never here.
# AUTH_SIGNING_KEYS_JSON=
# Dev only: the compose stack mounts infra/dev/auth-signing-dev.json instead.
# AUTH_SIGNING_KEYS_FILE=/etc/mdx/auth-signing.json

# ── Email one-time codes ──────────────────────────────────────────────────
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60
# Abuse caps (fixed windows). start_* fail closed when Redis is down.
AUTH_OTP_START_EMAIL_LIMIT=5
AUTH_OTP_START_EMAIL_WINDOW_SECONDS=900
AUTH_OTP_START_IP_LIMIT=20
AUTH_OTP_START_IP_WINDOW_SECONDS=3600
AUTH_OTP_VERIFY_IP_LIMIT=60
AUTH_OTP_VERIFY_IP_WINDOW_SECONDS=900
# Code mail is sent inline, not through the outbox worker.
AUTH_EMAIL_SEND_TIMEOUT_SECONDS=5
# Lockout after repeated failures: 10 → 15 min, doubling, capped at 1 h.
AUTH_LOCKOUT_THRESHOLD=10
AUTH_LOCKOUT_BASE_SECONDS=900
AUTH_LOCKOUT_MAX_SECONDS=3600
# Comma-separated CIDRs whose X-Forwarded-For is believed (empty: TCP peer is the client).
TRUSTED_PROXY_CIDRS=

# ── Recipient links + the shared page (note-service) ─────────────────
MDX_PRODUCT_BRAND_NAME=Notes AI
# Recipient links expire after this many days unless the sender picks.
MDX_RECIPIENT_LINK_DEFAULT_DAYS=90
# Abuse caps on the anonymous /v1/shared/* surface (fail-open on Redis outage).
MDX_SHARED_RL_IP_PER_MINUTE=60
MDX_SHARED_RL_LINK_PER_HOUR=300
MDX_SHARED_RL_CTA_PER_HOUR=20
# note-service reads TRUSTED_PROXY_CIDRS (above) for the per-IP key too.

# ── Recipient mail (note-service) ────────────────────────────────────
# Public origin of the note API — the unsubscribe link in recipient mail.
MDX_API_PUBLIC_BASE_URL=http://localhost:8006
# Sends per link / sender / workspace per day.
MDX_SHARE_MAIL_LINK_PER_DAY=3
MDX_SHARE_MAIL_USER_PER_DAY=50
MDX_SHARE_MAIL_TENANT_PER_DAY=200
# Pepper for the opt-out hash (hex). Rotating it orphans every suppression.
MDX_SHARE_MAIL_SUPPRESSION_PEPPER_HEX=6d64782d6465762d73686172652d6d61696c2d7065707065722d3030303030

# ── Sharing flags, verification, retention (note-service) ────────────
# Master switch for the loop: off → no external links, recipient pages 404.
MDX_EXTERNAL_SHARING_ENABLED=true
# Off → the shared page reads, nobody can confirm/dispute/flag.
MDX_RECIPIENT_ACTIONS_ENABLED=true
# Recipient verification codes (policy `verified_recipients_required`).
MDX_SHARE_OTP_TTL_SECONDS=600
MDX_SHARE_OTP_MAX_ATTEMPTS=5
# Links expired longer than this lose responses, address and codes (nightly job).
MDX_SHARE_RETENTION_DAYS=30
