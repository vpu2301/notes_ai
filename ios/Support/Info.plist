<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Notes AI</string>
	<key>CFBundleDisplayName</key>
	<string>Notes AI</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Notes AI records meeting audio so it can be transcribed into a note.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Notes AI uses Face ID to unlock the password saved on this phone, so you do not have to type it again.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Notes AI talks to your Notes AI server, which may run on a computer on your Wi‑Fi.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Notes AI shows your upcoming calendar events so you can start a meeting note from them.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.notes.capture.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>notesai</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
#if DEV_HTTP
	<key>NSAllowsArbitraryLoads</key>
	<true/>
	<key>NSAllowsLocalNetworking</key>
	<true/>
#else
	<key>NSAllowsArbitraryLoads</key>
	<false/>
#endif
	</dict>
</dict>
</plist>
