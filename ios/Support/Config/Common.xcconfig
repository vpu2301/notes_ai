// Settings shared by both configurations.
//
// Info.plist goes through the C preprocessor (two ATS policies in one file).
// `-traditional` is required: otherwise the `//` in the DOCTYPE URL is read as
// a comment. `-Wno-invalid-pp-token` keeps apostrophes from starting a character literal.
INFOPLIST_PREPROCESS = YES
INFOPLIST_OTHER_PREPROCESSOR_FLAGS = -traditional -Wno-invalid-pp-token
