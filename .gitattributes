# Force LF line endings everywhere; no CRLF on Windows checkouts.
* text=auto eol=lf

*.py    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
Makefile text eol=lf

# Binary
*.png   binary
*.jpg   binary
*.gz    binary

# Eval-corpus audio via Git LFS (`git lfs install` once per clone).
eval/**/*.wav filter=lfs diff=lfs merge=lfs -text

# Tatoeba word lists (1.7 MB, generated) via Git LFS; CI checkouts set `lfs: true`.
libs/asr_models/src/asr_models/resources/*.txt filter=lfs diff=lfs merge=lfs -text
