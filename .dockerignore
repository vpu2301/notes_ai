# Keep the build context small: Dockerfiles COPY only pyproject.toml, uv.lock,
# libs/, services/<x>/ (tools image: scripts/ + infra/).
.venv
**/.venv
.git
.github
**/__pycache__
**/*.pyc
.mypy_cache
**/.mypy_cache
.ruff_cache
**/.ruff_cache
.pytest_cache
**/.pytest_cache
.hypothesis
.import_linter_cache
.DS_Store
**/.DS_Store
node_modules
**/node_modules
# Never bake local secrets into an image.
infra/dev/master.key
.env.local
*.pem
*.key

# Client apps
web/
macos/
ios/
clients/
