        "tags": [
          "internal"
        ]
      },
      "post": {
        "operationId": "begin_drain_internal_drain_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrainStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Begin scale-in drain",
        "tags": [
          "internal"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe \u2014 DB, Redis, Whisper, GPU",
        "tags": [
          "health"
        ]
      }
    }
  }
}
