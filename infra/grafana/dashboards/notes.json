{
  "title": "Notes",
  "uid": "notes",
  "schemaVersion": 39,
  "tags": [
    "reports"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Active drafts per tenant",
      "targets": [
        {
          "expr": "mdx_notes_active_drafts",
          "legendFormat": "{{tenant_id}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Create / Finalize / Amend rate (per minute)",
      "targets": [
        {
          "expr": "rate(mdx_notes_created_total[5m])",
          "legendFormat": "created"
        },
        {
          "expr": "rate(mdx_notes_finalized_total[5m])",
          "legendFormat": "finalized"
        },
        {
          "expr": "rate(mdx_notes_amended_total[5m])",
          "legendFormat": "amended {{amendment_type}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Search latency (split by has_q)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(mdx_notes_search_latency_ms_histogram_bucket[5m])) by (le, has_q))",
          "legendFormat": "p50 has_q={{has_q}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(mdx_notes_search_latency_ms_histogram_bucket[5m])) by (le, has_q))",
          "legendFormat": "p95 has_q={{has_q}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(mdx_notes_search_latency_ms_histogram_bucket[5m])) by (le, has_q))",
          "legendFormat": "p99 has_q={{has_q}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Autosave conflict rate (% of PUTs)",
      "targets": [
        {
          "expr": "100 * rate(mdx_notes_autosave_conflicts_total[10m]) / rate(mdx_notes_diff_cache_lookups_total[10m])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Diff cache hit ratio",
      "targets": [
        {
          "expr": "sum(rate(mdx_notes_diff_cache_lookups_total{hit=\"true\"}[5m])) / sum(rate(mdx_notes_diff_cache_lookups_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Chain integrity check failures (24h)",
      "targets": [
        {
          "expr": "increase(mdx_notes_chain_integrity_check_failures_total[24h])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Generated lines by outcome (support gate)",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(mdx_note_generation_lines_total[15m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Excluded share of speech (p50 / p95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mdx_note_generation_excluded_share_bucket[1h])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mdx_note_generation_excluded_share_bucket[1h])))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Facts and noise flags by outcome",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(mdx_note_generation_facts_total[15m]))",
          "legendFormat": "facts {{outcome}}"
        },
        {
          "expr": "sum by (outcome) (rate(mdx_note_generation_noise_total[15m]))",
          "legendFormat": "noise {{outcome}}"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 8
      }
    },
    {
      "type": "barchart",
      "title": "Recording types, how decided (7 d)",
      "targets": [
        {
          "expr": "sum by (outcome) (increase(mdx_note_generation_classify_total[7d]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Lines left out as repeats (render)",
      "targets": [
        {
          "expr": "sum(rate(mdx_note_generation_redundant_lines_total[1h]))",
          "legendFormat": "redundant lines / s"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Names in notes: respelled, doubted, unattributed",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(mdx_note_generation_entities_total[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      }
    }
  ]
}
