# Weekly notes-quality report: notes_quality.sql as funnel_reader → reports/notes-quality-YYYY-WW.csv (counts only)
CRON_TZ=UTC
45 6 * * 1  cd /opt/notes-ai-backend && DATABASE_URL=postgresql://funnel_reader:funnel_reader@localhost:5432/notes /usr/bin/env uv run python scripts/jobs/weekly_notes_quality.py >> /var/log/mdx/weekly-notes.log 2>&1
