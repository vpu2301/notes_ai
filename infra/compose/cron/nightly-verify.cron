# Nightly audit-chain verification (scripts/jobs/nightly_verify.py): host or
# sidecar cron, NOT a compose service. `make nightly-verify` runs it by hand.
# PROM_TEXTFILE MUST be inside node-exporter's --collector.textfile.directory.
# Env defaults target the dev stack; override in prod.

# m h  dom mon dow   command
SHELL=/bin/bash
PROM_TEXTFILE=/var/lib/node_exporter/textfile_collector/audit_chain.prom

# 02:00 UTC daily. Ensure the crond runs in UTC (CRON_TZ=UTC) or the host is UTC.
CRON_TZ=UTC
0 2 * * *  cd /opt/notes-ai-backend && /usr/bin/env uv run python scripts/jobs/nightly_verify.py >> /var/log/mdx/nightly-verify.log 2>&1
