# Weekly speaker-quality report: speaker_quality.sql as funnel_reader → reports/speakers-YYYY-WW.csv (counts only)
CRON_TZ=UTC
30 6 * * 1  cd /opt/notes-ai-backend && DATABASE_URL=postgresql://funnel_reader:funnel_reader@localhost:5432/notes /usr/bin/env uv run python scripts/jobs/weekly_speakers.py >> /var/log/mdx/weekly-speakers.log 2>&1
