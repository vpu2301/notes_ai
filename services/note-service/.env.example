# Copy to .env.local. Never commit .env.local.
ENVIRONMENT=development
LOG_LEVEL=INFO

AUTH_ISSUER=http://localhost:8088/realms/notes
AUTH_JWKS_URL=http://localhost:8088/realms/notes/protocol/openid-connect/certs
AUTH_AUDIENCE=mdx-api

DB_APP_ROLE_DSN=postgresql://app_role:app_role@localhost:5432/notes
DB_AUDIT_WRITER_DSN=postgresql://audit_writer:audit_writer@localhost:5432/notes

MDX_TEMPLATE_CACHE_MAXSIZE=5000
MDX_TEMPLATE_CACHE_TTL_SECONDS=60
