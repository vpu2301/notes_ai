# auth-service — local overrides. Copy to `.env.local` (gitignored).
# Only the password-recovery settings are listed; everything else has a dev default in config.py.

# ── Feature switch (OFF by default; the endpoints 404 until true) ────
MDX_PASSWORD_RESET_ENABLED=true

# ── Mail: `mock` (refuses to run in production) or `smtp` ────────────
MDX_EMAIL_PROVIDER=smtp

# Dev: Mailpit, no TLS, no credentials (http://localhost:8025).
MDX_AUTH_SMTP_HOST=localhost
MDX_AUTH_SMTP_PORT=1025
MDX_AUTH_SMTP_USE_TLS=false
MDX_AUTH_SMTP_USERNAME=
MDX_AUTH_SMTP_PASSWORD=

# Production (Google Workspace):
#   MDX_AUTH_SMTP_HOST=smtp.gmail.com
#   MDX_AUTH_SMTP_PORT=587
#   MDX_AUTH_SMTP_USE_TLS=true
#   MDX_AUTH_SMTP_USERNAME=sales@notes-ai.local
#   MDX_AUTH_SMTP_PASSWORD=<16-char App Password>
# NOT the account password: Google Workspace needs an App Password (symptom otherwise: 535-5.7.8).

MDX_AUTH_EMAIL_FROM=sales@notes-ai.local
MDX_AUTH_EMAIL_FROM_NAME=Notes AI
MDX_AUTH_EMAIL_REPLY_TO=sales@notes-ai.local

# ── Links: the SPA origin every mailed link is built from ────────────
MDX_APP_BASE_URL=http://localhost:5173
MDX_SUPPORT_URL=https://notes-ai.local/contact

# ── Lifetimes ────────────────────────────────────────────────────────
# Reset link: 30 minutes.
MDX_PASSWORD_RESET_TTL_SECONDS=1800
# Lockdown link: 7 days (the account holder may read the mail late).
MDX_LOCKDOWN_TOKEN_TTL_SECONDS=604800

# ── Policy ───────────────────────────────────────────────────────────
# Floored at 8 in code (NIST SP 800-63B).
MDX_PASSWORD_MIN_LENGTH=12

# ── Abuse caps (per hour, fail-OPEN if Redis is down) ────────────────
MDX_PASSWORD_RESET_IP_PER_HOUR=20
MDX_PASSWORD_RESET_EMAIL_PER_HOUR=5

# MUST be set per deployment (unsalted IP hashes are brute-forceable).
MDX_PASSWORD_RESET_IP_HASH_SALT=dev-ip-hash-salt-change-in-prod

# ── Outbox worker ────────────────────────────────────────────────────
MDX_BACKGROUND_JOBS=true
MDX_AUTH_MAIL_DELIVERY_INTERVAL_S=5
MDX_AUTH_MAIL_DELIVERY_BATCH=25
MDX_AUTH_MAIL_DELIVERY_MAX_ATTEMPTS=5
MDX_AUTH_MAIL_DELIVERY_BACKOFF_BASE_S=60

# ── Session revocation ───────────────────────────────────────────────
# Off: only Keycloak's logout runs and issued access tokens stay valid until expiry.
MDX_SESSION_REVOCATION_ENABLED=true
REDIS_URL=redis://localhost:6379/0
